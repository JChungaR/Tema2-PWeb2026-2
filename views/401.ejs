<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <link
        rel="icon"
        type="image/x-icon"
        href="/favicon.ico"
    >

    <!-- Bootstrap 5 -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap"
        rel="stylesheet"
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
        rel="stylesheet"
    >

    <!-- Font Awesome 7.3.1 -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
    >

    <title>Acceso denegado</title>

    <style>
        /* Estructura general */
        body {
            margin: 0;
            min-height: 100vh;
            background-color: #ffffff;
            padding: 0;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
        }

        /* Contenido principal */
        .pagina-401 {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            background-color: #f6f8f8;
            text-align: center;
            min-height: 500px;
        }

        .contenido-401 {
            width: 100%;
            max-width: 450px;
        }

        /* Icono de acceso denegado */
        .icono-401 {
            width: 58px;
            height: 58px;
            margin: 0 auto 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background-color: #fbeaea;
            color: #cf2929;
            font-size: 21px;
        }

        /* Título */
        .contenido-401 h1 {
            margin-top: 0;
            margin-bottom: 10px;
            color: #1b2927;
            font-family: Manrope, sans-serif;
            font-size: 26px;
            font-weight: 800;
        }

        /* Descripción */
        .descripcion-401 {
            max-width: 400px;
            margin: 0 auto 14px;
            color: #6c7a78;
            font-family: Inter, sans-serif;
            font-size: 12px;
            line-height: 1.5;
        }

        /* Contenedor de botones */
        .acciones-401 {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        /* Botón cerrar sesión */
        .btn-cerrar-sesion {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 33px;
            padding: 7px 15px;
            border: 1px solid #136f63;
            border-radius: 3px;
            background-color: transparent;
            color: #136f63;
            font-family: Inter, sans-serif;
            font-size: 11px;
            font-weight: 600;
            text-decoration: none;
            transition: background-color 0.2s ease;
        }

        .btn-cerrar-sesion:hover {
            background-color: #e3efed;
            color: #0e5b52;
        }

        /* Botón volver a las reservas */
        .btn-volver-reservas {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 33px;
            padding: 7px 18px;
            border: 1px solid #136f63;
            border-radius: 3px;
            background-color: #136f63;
            color: #ffffff;
            font-family: Inter, sans-serif;
            font-size: 11px;
            font-weight: 600;
            text-decoration: none;
            transition: background-color 0.2s ease;
        }

        .btn-volver-reservas:hover {
            background-color: #0e5b52;
            border-color: #0e5b52;
            color: #ffffff;
        }

        /* Adaptación para móviles */
        @media (max-width: 480px) {
            .contenido-401 h1 {
                font-size: 24px;
            }

            .descripcion-401 {
                font-size: 12px;
            }

            .acciones-401 {
                gap: 8px;
            }
        }
    </style>
</head>

<body>


    <!-- CONTENIDO 401 -->
    <main class="pagina-401">

        <div class="contenido-401">

            <!-- Icono -->
            <div class="icono-401">
                <i class="fa-solid fa-ban" aria-hidden="true"></i>
            </div>

            <!-- Título -->
            <h1>
                Acceso denegado
            </h1>

            <!-- Mensaje -->
            <p class="descripcion-401">
                <%= message || 'Debes iniciar sesión para acceder a esta página.' %>
            </p>

            <!-- Botones -->
            <div class="acciones-401">

                <!-- Cerrar sesión -->
                <a
                    href="/logout"
                    class="btn-cerrar-sesion"
                >
                    Cerrar sesión
                </a>

                <!-- Volver a mis reservas -->

                
                <a href="<%= rutaInicio %>" class="btn-volver-reservas">
                    Volver a mi inicio
                </a>
                

            </div>

        </div>

    </main>

    <!-- FOOTER -->
    <%- include("partials/_footer-visit") %>

</body>

</html>
