<% layout("layouts/h1-visit") %>

<main class="account-created-main">
    <div class="account-created-card">

        <div class="account-created-icon">
            <i class="fa-solid fa-circle-check"></i>
        </div>

        <h1>Solicitud enviada</h1>

        <p>
            Se evaluará la solicitud enviada. En caso de ser aceptada, 
            se enviará un enlace de confirmación a  
            <strong><%= email %></strong>. 

        </p>

        <a href="/sign-in" class="account-created-button">
            Ir a iniciar sesión
        </a>

        <a href="/" class="account-created-link">
            Volver al inicio
        </a>

    </div>
</main>