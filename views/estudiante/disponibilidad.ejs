
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #f5f7fb;
  color: #25334a;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 14px;
}

button, input, select {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
}

.hu3 {
  min-height: 100vh;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 18px 5%;
  background: white;
  border-bottom: 1px solid #e0e6ef;
}

.brand {
  font-size: 24px;
  font-weight: 800;
  color: #263c65;
  white-space: nowrap;
}

.brand span {
  color: #4386e8;
}

.topbar nav {
  display: flex;
  flex-wrap: wrap;
  gap: 22px;
}

.topbar nav a {
  color: #64748b;
  text-decoration: none;
}

.topbar nav a.active {
  color: #3678d8;
  font-weight: bold;
}

.user {
  color: #53647c;
  font-size: 12px;
  font-weight: bold;
}

.content {
  display: grid;
  grid-template-columns: 270px minmax(0, 1fr);
  gap: 28px;
  max-width: 1500px;
  margin: auto;
  padding: 28px 5%;
}

.filters, .calendar-section {
  background: white;
  border: 1px solid #e1e7ef;
  border-radius: 12px;
  padding: 22px;
}

.filters {
  align-self: start;
}

.filter-heading, .results-heading, .calendar-heading,
.card-title, .card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}

.filter-heading h2, h1, h2, h3, p {
  margin-top: 0;
}

.filter-heading h2 {
  margin-bottom: 18px;
}

.text-button {
  border: 0;
  background: none;
  color: #3479db;
  font-size: 12px;
}

.filters > label {
  display: block;
  margin: 18px 0 8px;
  font-weight: 600;
}

.filters select, .filters input[type="date"],
.filters input[type="time"], .sort select {
  width: 100%;
  min-width: 0;
  padding: 10px;
  border: 1px solid #d7dfeb;
  border-radius: 7px;
  background: white;
  color: #334155;
}

.filters input[type="range"] {
  width: 100%;
  accent-color: #367de0;
}

.range-labels {
  display: flex;
  justify-content: space-between;
  color: #7b8799;
  font-size: 11px;
}

.checks {
  display: grid;
  gap: 12px;
}

.check {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #526178;
}

.check input {
  accent-color: #367de0;
}

.time-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.time-row input {
  width: 0;
  flex: 1;
  min-width: 0;
}

.primary, .secondary {
  padding: 11px 15px;
  border: 0;
  border-radius: 7px;
  font-weight: 600;
}

.primary {
  background: #347ce0;
  color: white;
}

.primary:hover {
  background: #2669c7;
}

.primary:disabled {
  opacity: .5;
}

.secondary {
  background: #edf2f8;
  color: #45566f;
}

.full {
  display: block;
  width: 100%;
  margin-top: 12px;
}

.error {
  color: #c0392b;
  font-size: 12px;
}

.results {
  min-width: 0;
}

.results-heading {
  align-items: flex-end;
  margin-bottom: 22px;
}

.eyebrow {
  margin-bottom: 8px;
  color: #4381d7;
  font-size: 11px;
  font-weight: bold;
  letter-spacing: 1.2px;
}

h1 {
  margin-bottom: 8px;
  color: #24334c;
  font-size: 28px;
}

h2 {
  color: #263750;
}

.muted {
  color: #7a8799;
  line-height: 1.5;
}

.sort {
  display: grid;
  gap: 7px;
  min-width: 180px;
  color: #68768b;
  font-size: 12px;
}

.active-filters {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin-bottom: 20px;
}

.active-filters strong {
  font-size: 12px;
}

.active-filters button {
  padding: 7px 10px;
  border: 1px solid #d9e6f8;
  border-radius: 20px;
  background: #edf5ff;
  color: #346bb5;
  font-size: 12px;
}

.active-filters .clear-chip {
  border-color: transparent;
  background: transparent;
  color: #64748b;
}

.cards {
  display: grid;
  gap: 16px;
}

.space-card {
  display: grid;
  grid-template-columns: 150px minmax(0, 1fr);
  overflow: hidden;
  border: 1px solid #e0e6ef;
  border-radius: 12px;
  background: white;
}

.card-art {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 12px;
  min-height: 190px;
  padding: 18px;
  background: linear-gradient(145deg, #dbeafe, #e8e8f8);
  color: #365a92;
}

.card-art span {
  font-size: 12px;
}

.card-art b {
  font-size: 25px;
}

.space-card:nth-child(2n) .card-art {
  background: linear-gradient(145deg, #d9f3e8, #e9f6f1);
  color: #32745d;
}

.space-card:nth-child(3n) .card-art {
  background: linear-gradient(145deg, #f9e7d7, #f8f0e5);
  color: #976537;
}

.card-body {
  min-width: 0;
  padding: 18px;
}

.card-title {
  align-items: flex-start;
}

.card-title h3 {
  margin-bottom: 8px;
  font-size: 16px;
}

.status {
  flex-shrink: 0;
  padding: 5px 8px;
  border-radius: 20px;
  background: #e0f5e9;
  color: #238252;
  font-size: 11px;
}

.card-body p {
  margin-bottom: 9px;
}

.equipment {
  color: #526178;
  font-size: 12px;
}

.card-bottom {
  align-items: flex-end;
  margin-top: 18px;
}

.card-bottom > div {
  display: grid;
  gap: 5px;
}

.card-bottom small {
  color: #7a8799;
  font-size: 10px;
}

.card-bottom strong {
  color: #26845b;
  font-size: 23px;
}

.empty {
  padding: 40px 20px;
  border: 1px dashed #cbd5e1;
  border-radius: 12px;
  background: white;
  text-align: center;
}

.calendar-section {
  margin-top: 26px;
}

.calendar-heading {
  align-items: flex-start;
}

.calendar-heading h2 {
  margin-bottom: 8px;
}

.week-nav {
  display: flex;
  gap: 6px;
}

.week-nav button {
  padding: 7px 12px;
  border: 1px solid #dce4ef;
  border-radius: 6px;
  background: white;
  color: #435570;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin: 20px 0;
  color: #64748b;
  font-size: 12px;
}

.legend span {
  display: flex;
  align-items: center;
  gap: 6px;
}

.dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
}

.dot.free {
  background: #43ad79;
}

.dot.busy {
  background: #e3a2a2;
}

.dot.unavailable {
  background: #a8b1bf;
}

.calendar-wrap {
  overflow-x: auto;
}

.calendar {
  width: 100%;
  min-width: 650px;
  border-collapse: collapse;
  font-size: 11px;
}

.calendar th, .calendar td {
  padding: 5px;
  border: 1px solid #e4e9f0;
  text-align: center;
}

.calendar thead th {
  background: #f6f8fc;
  color: #526178;
}

.calendar tbody th {
  background: #fafbfd;
  color: #64748b;
}

.calendar td button {
  width: 100%;
  min-width: 65px;
  padding: 8px 3px;
  border: 0;
  border-radius: 4px;
  background: transparent;
  font-size: 10px;
}

.calendar .is-free {
  background: #e5f6ed;
}

.calendar .is-free button {
  color: #24794f;
}

.calendar .is-busy {
  background: #fbe9e9;
}

.calendar .is-busy button {
  color: #a44d4d;
}

.calendar .is-unavailable {
  background: #edf0f4;
}

.calendar .is-unavailable button {
  color: #7c8796;
}

.calendar td.is-selected {
  outline: 2px solid #347ce0;
  outline-offset: -2px;
}

.selected-note {
  margin-top: 16px;
  padding: 13px;
  border-radius: 7px;
  background: #edf5ff;
  color: #315d99;
  line-height: 1.5;
}

.footer {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 22px 5%;
  border-top: 1px solid #e1e7ef;
  background: white;
  color: #718096;
  font-size: 12px;
}

@media (max-width: 1000px) {
  .topbar {
    flex-wrap: wrap;
  }

  .content {
    grid-template-columns: 1fr;
  }

  .filters {
    width: 100%;
  }
}

@media (max-width: 600px) {
  .topbar nav {
    gap: 12px;
  }

  .results-heading, .calendar-heading {
    align-items: stretch;
    flex-direction: column;
  }

  .sort {
    width: 100%;
  }

  .space-card {
    grid-template-columns: 1fr;
  }

  .card-art {
    min-height: 100px;
  }

  .card-title {
    flex-wrap: wrap;
  }

  .footer {
    flex-direction: column;
  }
}

