<!-- views/partials/_navbar.ejs -->

<nav class="navbar navbar-expand-lg sticky-top" style="background-color: rgb(255, 255, 255); border-bottom: 2px solid #dddcdceb;;">

  <div class="container">

    <!-- Brand -->
        <a class="navbar-brand fw-bold fs-4 me-4" href="/">

            <span style="color: #0f6c5f; font-family: Manrope; font-weight: bolder;">
                Reserva
            </span>
            
            <span class="text-dark" style="font-family: Manrope; font-weight: bolder;">
                UL
            </span>

        </a>


    <!-- Mobile button -->
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarContent"
      aria-controls="navbarContent"
      aria-expanded="false"
      aria-label="Abrir menú">

      <span class="navbar-toggler-icon"></span>

    </button>


    <!-- Navbar content -->
    <div
      class="collapse navbar-collapse"
      id="navbarContent">


      <!-- Main navigation -->
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">

        <!-- Espacios -->
        <li class="nav-item">

          <a class="nav-link" href="/spaces" style="font-family: Manrope; color: rgba(106, 122, 120); font-weight: bolder;">

            Espacios

          </a>

        </li>


        <!-- Reglas de uso -->
        <li class="nav-item">

          <a class="nav-link" href="/reglas" style="font-family: Manrope; color: rgba(106, 122, 120); font-weight: bolder;">

            Reglas de uso

          </a>

        </li>


        <!-- Ayuda -->
        <li class="nav-item">

          <a class="nav-link" href="/ayuda" style="font-family: Manrope; color: rgba(106, 122, 120); font-weight: bolder;">

            Ayuda

          </a>

        </li>

      </ul>


      <!-- Authentication buttons -->
      <div class="d-flex" style="gap: 15px">

        <% if (currentPage !== 'sign-in') { %>

          <a href="/sign-in" class="btn-signIn link-underline link-underline-opacity-0" style="text-align: center; font-weight:bold;">

            Ingresar

          </a>

        <% } %>


        <% if (currentPage !== 'sign-up' && currentPage !== '404') { %>

          <a href="/sign-up" class="btn-signUp link-underline link-underline-opacity-0" style="text-align: center; font-weight: bold;">

            Crear cuenta

          </a>

        <% } %>

      </div>

    </div>

  </div>

</nav>

