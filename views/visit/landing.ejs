<% layout("layouts/h1-visit") %>

<!-- =========================================
     SECCIÓN PRINCIPAL
     ========================================= -->
  <main class="contenido-landing">
    
    <div style="display: flex;">

      <div class="parte-principal p-5">

        <h1 class="mb-3" style="font-family: Manrope; font-size: 41.5px; color: rgba(21, 35, 34); font-weight: bolder;">

          Reserva salas, laboratorios y cabinas <br>
          del campus por bloques de una hora

        </h1>

        <p style="color: rgba(106, 122, 120); font-family: Inter; font-size: 16px;" class="mb-3">

          Consulta la disponibilidad de la semana, elige tu bloque y confirma en menos de un minuto.

        </p>

        <!-- =========================================
            BÚSQUEDA DE ESPACIOS
            Relacionado con:
            campuses
            space_types
            spaces
            availability_blocks
            ========================================= -->

        <form class="formulario-busqueda" action="/espacios" method="GET">

          <!-- Campus -->

          <div class="agrupar-vertical">

            <label for="campus" class="form-label" style="font-family: Inter; font-size: 15px; font-weight: bolder; color: rgba(106, 122, 120)">

              SEDE

            </label>

            <select id="campus" name="campus" class="form-select" style="font-family: Inter; font-size: 14px; color: rgba(21, 35, 34)">

              <option selected value="">
                Campus Monterrico
              </option>

              <option value="mayorazgo">
                Campus Mayorazgo
              </option>

            </select>

          </div>

          <!-- Tipo de espacio -->

          <div class="agrupar-vertical" style="margin-left: 12px;">

            <label for="tipo" class="form-label" style="font-family: Inter; font-size: 15px; font-weight: bolder; color: rgba(106, 122, 120)">

              TIPO DE ESPACIO

            </label>

            <select id="tipo" name="space_type" class="form-select" style="font-family: Inter; font-size: 14px; color: rgba(21, 35, 34)">

              <option selected value="">
                Todos los espacios
              </option>

              <option value="sala-estudio">
                Sala de estudio grupal
              </option>

              <option value="laboratorio">
                Laboratorio de cómputo
              </option>

              <option value="cabina">
                Cabina de grabación
              </option>

              <option value="auditorio">
                Auditorio
              </option>

              <option value="sala-reunion">
                Sala de reuniones
              </option>

            </select>

          </div>

          <!-- Fecha -->

          <div class="agrupar-vertical" style="margin-left: 12px;">

            <label for="dia" class="form-label" style="font-family: Inter; font-size: 15px; font-weight: bolder; color: rgba(106, 122, 120)">

              DÍA

            </label>

            <input id="dia" name="date" type="text" placeholder="DD/MM/AAAA" class="form-control" style="font-family: Inter; font-size: 14px; color: rgba(21, 35, 34)">

          </div>

          <!-- Buscar -->

          <div class="agrupar-vertical" style="margin-left: 12px;">

            <button type="submit" class="btn btn-dark" style="font-family: Inter; font-weight: bolder;">

              Buscar

            </button>

          </div>

        </form>

      </div>

      <!-- Imagen principal -->

      <div>

        <img src="https://s3.eu-west-1.amazonaws.com/genial.ly/5b1195af36c5443891a0458a/252faba2-ef3f-467d-8f4b-38105fe977eb.jpeg" class="foto-sala-estudio" alt="Estudiantes utilizando un espacio de estudio">

      </div>

    </div>

    <!-- =========================================
        ESPACIOS DESTACADOS
        ========================================= -->

    <div class="parte-abajo">

      <div class="d-flex justify-content-between mb-3">

        <h4 style="font-family: Manrope; color: rgba(19, 111, 99); font-weight: bolder;">

          Espacios destacados hoy

        </h4>

        <a href="/sign-in" style="font-weight: bolder; color: rgba(19, 111, 99);" class="icon-link icon-link-hover link-underline-success link-offset-2 link-underline link-underline-opacity-0">

          Ver todo el catálogo

          <svg xmlns="http://www.w3.org/2000/svg" class="bi" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/>
          </svg>

        </a>

      </div>

      <!-- =========================================
          TARJETAS DE ESPACIOS
          ========================================= -->

      <div class="d-flex mb-3" style="gap: 12px;">

        <!-- Sala de estudio -->

        <div class="card">

          <img src="https://i.ytimg.com/vi/-Y-nLBVeTo0/maxresdefault.jpg" class="card-img-top" alt="Sala de estudio grupal">

          <div class="card-body">

            <h6 class="card-title">
              Sala de Estudio Grupal E-201
            </h6>

            <p style="font-family: Inter; color: rgba(106, 122, 120)" class="card-text mb-3">

              Pabellón E · Aforo 8

            </p>

            <a href="/sign-in" class="btn-carta" style="border-color: rgba(226, 241, 238); background: rgba(226, 241, 238); color: rgba(19, 111, 99);">

              6 bloques libres hoy

            </a>

          </div>

        </div>

        <!-- Laboratorio -->

        <div class="card">

          <img src="https://i.ytimg.com/vi/FdnqVY7bsGI/maxresdefault.jpg" class="card-img-top" alt="Laboratorio de cómputo">

          <div class="card-body">

            <h6 class="card-title">
              Laboratorio de Cómputo H-304
            </h6>

            <p style="font-family: Inter; color: rgba(106, 122, 120)" class="card-text mb-3">

              Ingeniería · Aforo 30

            </p>

            <a href="/sign-in" class="btn-carta" style="border-color: rgb(241, 236, 226); background: rgba(241, 236, 226); color: rgba(183, 121, 31);">

              2 bloques libres hoy

            </a>

          </div>

        </div>



        <!-- Cabina -->

        <div class="card">

          <img src="https://infomercado.pe/wp-content/uploads/2019/04/Universidad-de-LIma.jpeg" class="card-img-top" alt="Cabina de grabación">

          <div class="card-body">

            <h6 class="card-title">
              Cabina de Grabación N-105
            </h6>

            <p style="font-family: Inter; color: rgba(106, 122, 120)" class="card-text mb-3">

              Pabellón N · Aforo 3

            </p>

            <a href="/sign-in" class="btn-carta" style="border-color: rgba(226, 241, 238); background: rgba(226, 241, 238); color: rgba(19, 111, 99);">

              5 bloques libres hoy

            </a>

          </div>

        </div>



        <!-- Auditorio -->

        <div class="card">

          <img src="https://centroculturalulima.com/wp-content/uploads/2022/05/Auditorio-Central.jpg" class="card-img-top" alt="Auditorio">

          <div class="card-body">

            <h6 class="card-title">
              Auditorio Q-101
            </h6>

            <p style="font-family: Inter; color: rgba(106, 122, 120)" class="card-text mb-3">

              Pabellón Q · Aforo 120

            </p>

            <a href="/sign-in" class="btn-carta" style="border-color: rgb(242, 213, 213); background: rgba(242, 213, 213); color: rgba(180, 50, 43);">

              Sin bloques libres hoy

            </a>

          </div>

        </div>


      </div>

      <!-- =========================================
          INFORMACIÓN DE USO
          ========================================= -->

      <div class="d-flex cuadro-verde" style="font-family: Manrope; color: rgba(19, 111, 99); font-weight: bolder; gap: 30px;">

        <!-- Límite de reservas -->

        <div class="agrupar-vertical">

          <h6 style="font-family: Manrope; color: rgba(19, 111, 99); font-weight: bolder;" class="mb-2">

            Tope de 8 horas semanales

          </h6>

          <p style="font-family: Inter; color: rgb(0, 0, 0); font-weight: normal; font-size: 13px;">

            Cada estudiante reserva hasta 8 bloques por semana entre todos
            <br>
            los espacios.

          </p>

        </div>



        <!-- Tolerancia -->

        <div class="agrupar-vertical">

          <h6 style="font-family: Manrope; color: rgba(19, 111, 99); font-weight: bolder;" class="mb-2">

            Tolerancia de 15 minutos

          </h6>

          <p style="font-family: Inter; color: rgb(0, 0, 0); font-weight: normal; font-size: 13px;">

            Pasada la tolerancia, el encargado puede marcar la inasistencia y
            <br>
            liberar el bloque.

          </p>

        </div>

        <!-- Cancelación -->

        <div class="agrupar-vertical">

          <h6 style="font-family: Manrope; color: rgba(19, 111, 99); font-weight: bolder;" class="mb-2">

            Cancelación con 2 horas

          </h6>

          <p style="font-family: Inter; color: rgb(0, 0, 0); font-weight: normal; font-size: 13px;">

            Cancela hasta 2 horas antes del inicio para no acumular
            <br>
            inasistencias.

          </p>

        </div>

      </div>

    </div>
    
  </main>