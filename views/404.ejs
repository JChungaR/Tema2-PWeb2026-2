<!DOCTYPE html>

<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <link
    rel="icon"
    type="image/x-icon"
    href="/favicon.ico"
  >

  <!-- Bootstrap 5 -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Manrope:wght@200..800&display=swap" rel="stylesheet">


  <!-- Font Awesome 7.3.1 -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
  >


  <title>Página no encontrada</title>

  <style>
      /* Estructura general */
      body {
          margin: 0;
          min-height: 100vh;
          background-color: rgba(255, 255, 255);
          background-size: cover;
          background-position: center;
          background-repeat: no-repeat;
          background-attachment: fixed;
          padding: 0;
          overflow-x: hidden;
          display: flex;
          flex-direction: column;
      }

      .pagina-404 {
          flex: 1;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 40px 20px;
          background-color: #f6f8f8;
          text-align: center;
          min-height: 100vh;
      }

      .contenido-404 {
          width: 100vh;
      }

      /* Código 404 */
      .codigo-404 {
          margin: 0;
          color: #136f63;
          font-size: 100px;
          font-weight: bolder;
          line-height: 1.1;
      }

      /* Título */
      .contenido-404 h2 {
          margin-top: 8px;
          margin-bottom: 10px;
          color: #1b2927;
          font-size: 30px;
          font-weight: bolder;
      }

      /* Descripción */
      .descripcion-404 {
          max-width: 400px;
          margin: 0 auto 22px;
          color: #6c7a78;
          font-size: 18px;
          line-height: 1.5;
      }

      /* Botón */
      .btn-inicio-404 {
          display: inline-block;
          padding: 8px 18px;
          border: 1px solid #136f63;
          border-radius: 3px;
          background-color: #136f63;
          color: white;
          font-size: 19px;
          font-weight: 600;
          text-decoration: none;
          transition: background-color 0.2s ease;
      }

      .btn-inicio-404:hover {
          background-color: #0e5b52;
          border-color: #0e5b52;
          color: white;
      }

      .btn-signIn {
          width: 130px;
          height: 40px;
          border-radius: 4px;
          border: 2px solid rgba(19, 111, 99);
          background: rgb(255, 255, 255);
          padding: 5px;
          color: rgba(19, 111, 99);
      }

      .btn-signUp {
          width: 130px;
          height: 40px;
          border-radius: 4px;
          border: 1px solid rgba(19, 111, 99);
          background: rgba(19, 111, 99);
          padding: 5px;
          color:rgb(255, 255, 255);
      }

  </style>

</head>


<body>


  <!-- =====================================================
       CONTENIDO 404
  ====================================================== -->

  <!-- =====================================================
       NAVBAR
  ====================================================== -->

  <%- include("partials/_navbar-visit") %>

  <main class="pagina-404">

    <div class="contenido-404">

        <!-- Código de error -->
        <h1 class="codigo-404" style="font-family: Manrope;">404</h1>

        <!-- Título -->
        <h2 style="font-family: Manrope;">Página no encontrada</h2>

        <!-- Descripción -->
        <p class="descripcion-404" style="font-family: Inter;">
            El espacio o la reserva que buscas ya no existe
            o cambió de dirección.
        </p>

        <!-- Botón para volver al inicio -->
        <a href="/" class="btn-inicio-404">
            Ir al inicio
        </a>

    </div>

</main>


  <!-- =====================================================
       FOOTER
  ====================================================== -->

  <%- include("partials/_footer-visit") %>

</body>

</html>