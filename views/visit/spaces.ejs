<% layout("layouts/h1-visit") %>

<main class="espacios-main">

    <!-- Encabezado -->
    <section class="espacios-encabezado">
        <h1>Espacios de la Universidad de Lima</h1>
        <p>
            Conoce los ambientes de nuestro campus, sus características
            y los servicios que ofrecen.
        </p>
    </section>

    <!-- Catálogo de espacios -->
    <section class="espacios-catalogo">

        <div class="espacios-grid">

            <!-- Espacio 1 -->

                <img
                    src="https://i.ytimg.com/vi/-Y-nLBVeTo0/maxresdefault.jpg"
                    alt="Sala de estudio"
                    class="espacio-imagen"
                >

                <div class="espacio-contenido">
                    <span class="espacio-tipo">Estudio</span>
                    <h3>Sala de estudio</h3>

                    <h2>
                        Ambiente destinado al estudio individual o grupal,
                        ideal para realizar trabajos académicos y repasar
                        contenidos en un espacio tranquilo.
                    </h2>

                </div>

            <!-- Espacio 2 -->

                <img
                    src="https://i.ytimg.com/vi/-Y-nLBVeTo0/maxresdefault.jpg"
                    alt="Laboratorio de computación"
                    class="espacio-imagen"
                >

                <div class="espacio-contenido">
                    <span class="espacio-tipo">Laboratorio</span>
                    <h3>Laboratorio de computación</h3>

                    <h2>
                        Ambiente equipado para actividades académicas
                        que requieren computadoras y herramientas
                        tecnológicas.
                    </h2>

                </div>

            <!-- Espacio 3 -->

                <img
                    src="https://i.ytimg.com/vi/-Y-nLBVeTo0/maxresdefault.jpg"
                    alt="Cabina de estudio"
                    class="espacio-imagen"
                >

                <div class="espacio-contenido">
                    <span class="espacio-tipo">Cabina</span>
                    <h3>Cabina de estudio</h3>

                    <h2>
                        Espacio de dimensiones reducidas pensado para
                        estudiar de manera individual y concentrarse
                        en las actividades académicas.
                    </h2>

                </div>


            <!-- Espacio 4 -->

                <img
                    src="https://i.ytimg.com/vi/-Y-nLBVeTo0/maxresdefault.jpg"
                    alt="Auditorio"
                    class="espacio-imagen"
                >

                <div class="espacio-contenido">
                    <span class="espacio-tipo">Auditorio</span>
                    <h3>Auditorio</h3>

                    <h2>
                        Ambiente amplio destinado a conferencias, exposiciones,
                        presentaciones y eventos académicos. Cuenta con espacios
                        para el público y condiciones adecuadas para actividades
                        que requieren reunir a un grupo numeroso de personas.
                    </h2>

                </div>

            <!-- Espacio 5 -->

                <img
                    src="https://i.ytimg.com/vi/-Y-nLBVeTo0/maxresdefault.jpg"
                    alt="Sala de reuniones"
                    class="espacio-imagen"
                >

                <div class="espacio-contenido">
                    <span class="espacio-tipo">Reunión</span>
                    <h3>Sala de reuniones</h3>

                    <h2>
                        Ambiente para coordinar proyectos, realizar
                        reuniones de trabajo y desarrollar actividades
                        colaborativas.
                    </h2>

                </div>


        </div>

        <p class="espacios-nota">
            La información presentada es referencial y puede actualizarse
            según los espacios registrados en el sistema.
        </p>

    </section>

</main>