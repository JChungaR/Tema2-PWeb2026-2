<% layout("layouts/h1-visit") %>


  <div style="display: flex;">
  
    <div class="parte-principal p-5">

      <h1 class="mb-3" style="font-family: Manrope; font-size: 41.5px; color: rgba(21, 35, 34); font-weight:bolder;">
        Reserva salas, laboratorios y cabinas <br>
        del campus por bloques de una hora
      </h1>

      <p style="color: rgba(106, 122, 120); font-family: Inter; font-size: 16px;" class="mb-3">
        Consulta la disponibilidad de la semana, elige tu bloque y confirma en menos de un minuto.
      </p>

      

        <div class="formulario-busqueda">

          <div class="agrupar-vertical">

            <label for="sede" class="form-label" style="font-family: Inter; font-size: 15px; font-weight: bolder; color: rgba(106, 122, 120)">
              SEDE
            </label>

            <select id="sede" class="form-select" style="font-family: Inter; font-size: 14px; color: rgba(21, 35, 34)">
              <option selected>Campus Monterrico</option>
              <option value="1">Campus Mayorazgo</option> 
            </select>
            
          </div>

          <div class="agrupar-vertical" style="margin-left: 12px;">

            <label for="tipo" class="form-label" style="font-family: Inter; font-size: 15px; font-weight: bolder; color: rgba(106, 122, 120)">
              TIPO DE ESPACIO
            </label>

            <select id="tipo" class="form-select" style="font-family: Inter; font-size: 14px; color: rgba(21, 35, 34)">
              <option selected>Sala de estudio grupal</option>
              <option value="1">Laboratorio de cómputo</option>
              <option value="2">Cabina de grabación</option>
              <option value="3">Auditorio</option>
              <option value="4">Sala de reuniones</option>
            </select>
            
          </div>

          <div class="agrupar-vertical" style="margin-left: 12px;">

            <label for="dia" class="form-label" style="font-family: Inter; font-size: 15px; font-weight: bolder; color: rgba(106, 122, 120)">
              DÍA
            </label>

            <input id="dia" name="dia" type="text" placeholder="DD/MM/AAAA" class="form-control" style="font-family: Inter; font-size: 14px; color: rgba(21, 35, 34)">

          </div>
          
      

          <div class="agrupar-vertical" style="margin-left: 12px;">

              <button type="button" class="btn btn-dark" style="font-family: Inter; font-weight: bolder">
              Buscar
              </button>

          </div>

        </div>

    </div>    

    <div>

      <img src="https://s3.eu-west-1.amazonaws.com/genial.ly/5b1195af36c5443891a0458a/252faba2-ef3f-467d-8f4b-38105fe977eb.jpeg" class="foto-sala-estudio" alt="fotografía-sala de estudio">
          
    </div>

  </div>
  
  <div class="parte-abajo">

    <div class="d-flex justify-content-between mb-3">
    
        <h4   style="font-family: Manrope; color: rgba(19, 111, 99); font-weight:bolder;">
            Espacios destacados hoy
        </h4>
        
          <a style="font-weight:bolder; color: rgba(19, 111, 99);" class="icon-link icon-link-hover link-underline-success link-offset-2 link-underline link-underline-opacity-0" href="#">
            Ver todo el catálogo
            <svg xmlns="http://www.w3.org/2000/svg" class="bi" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/>
            </svg>
          </a>

    </div>

    <div  class="d-flex mb-3" style="gap: 12px;">

        <div class="card">
          <img src="https://i.ytimg.com/vi/-Y-nLBVeTo0/maxresdefault.jpg" class="card-img-top" alt="Sala estudio grupal">
          <div class="card-body" style="height: 100px;">
            <h6 class="card-title">Sala de Estudio Grupal E-201</h6>
            <p style="font-family: Inter; color: rgba(106, 122, 120)" class="card-text mb-3">Pabellón E · Aforo 8</p>
            <a href="#" class="btn-carta" style="border-color: rgba(226, 241, 238); background: rgba(226, 241, 238); color:rgba(19, 111, 99);">6 bloques libres hoy</a>
          </div>
        </div>

        <div class="card">
          <img src="https://i.ytimg.com/vi/FdnqVY7bsGI/maxresdefault.jpg" class="card-img-top" alt="Sala estudio grupal">
          <div class="card-body" style="height: 100px;">
            <h6 class="card-title">Laboratorio de Cómputo H-304</h6>
            <p style="font-family: Inter; color: rgba(106, 122, 120)" class="card-text mb-3">Ingeniería · Aforo 30</p>
            <a href="#" class="btn-carta" style="border-color: rgb(241, 236, 226); background: rgba(241, 236, 226); color:rgba(183, 121, 31);">2 bloques libres hoy</a>
          </div>
        </div>

        <div class="card">
          <img src="https://infomercado.pe/wp-content/uploads/2019/04/Universidad-de-LIma.jpeg" class="card-img-top" alt="Sala estudio grupal">
          <div class="card-body" style="height: 100px;">
            <h6 class="card-title">Cabina de Grabación N-105</h6>
            <p style="font-family: Inter; color: rgba(106, 122, 120)" class="card-text mb-3">Pabellón N · Aforo 3</p>
            <a href="#" class="btn-carta" style="border-color: rgba(226, 241, 238); background: rgba(226, 241, 238); color:rgba(19, 111, 99);">5 bloques libres hoy</a>
          </div>
        </div>

        <div class="card">
          <img src="https://centroculturalulima.com/wp-content/uploads/2022/05/Auditorio-Central.jpg" class="card-img-top" alt="Sala estudio grupal">
          <div class="card-body" style="height: 100px;">
            <h6 class="card-title">Auditorio Q-101</h6>
            <p style="font-family: Inter; color: rgba(106, 122, 120)" class="card-text mb-3">Pabellón Q · Aforo 120</p>
            <a href="#" class="btn-carta" style="border-color: rgb(242, 213, 213); background: rgba(242, 213, 213); color:rgba(180, 50, 43);">Sin bloques libres hoy</a>
          </div>
        </div>
        
    </div>

    <div  class="d-flex cuadro-verde" style="font-family: Manrope; color: rgba(19, 111, 99); font-weight:bolder; gap: 30px;">

        <div class="agrupar-vertical">
            <h6 style="font-family: Manrope; color: rgba(19, 111, 99); font-weight:bolder;" class="mb-2">
                Tope de 8 horas semanales
            </h6>

            <p style="font-family: Inter; color: rgb(0, 0, 0); font-weight: normal; font-size:13px;">Cada estudiante reserva hasta 8 bloques por semana entre todos <br> los espacios.</p>

        </div>

        <div class="agrupar-vertical">
            <h6 style="font-family: Manrope; color: rgba(19, 111, 99); font-weight:bolder;" class="mb-2">
                Tolerancia de 15 minutos
            </h6>

            <p style="font-family: Inter; color: rgb(0, 0, 0); font-weight: normal; font-size:13px;">Pasada la tolerancia, el encargado puede marcar la inasistencia y <br> liberar el bloque.</p>

        </div>

        <div class="agrupar-vertical">
            <h6 style="font-family: Manrope; color: rgba(19, 111, 99); font-weight:bolder;" class="mb-2">
                Cancelación con 2 horas
            </h6>

            <p style="font-family: Inter; color: rgb(0, 0, 0); font-weight: normal; font-size:13px;">Cancela hasta 2 horas antes del inicio para no acumular <br> inasistencias.</p>

        </div>


    </div>

  </div>

  <!-- Bootstrap JS -->
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" >
  </script>


