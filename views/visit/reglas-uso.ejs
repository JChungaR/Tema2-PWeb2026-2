<% layout("layouts/h1-visit") %>


    <main class="pagina-reglas">

        <!-- Encabezado -->
        <section class="encabezado-reglas">
            <div class="contenedor-reglas">

                <span class="etiqueta-seccion">
                    <i class="fa-solid fa-book-open"></i>
                    Información para visitantes
                </span>

                <h1>Reglas de uso</h1>

                <p>
                    Conoce las normas generales para el uso responsable
                    de los espacios universitarios y el sistema de reservas.
                </p>

            </div>
        </section>

        <!-- Contenido -->
        <section class="contenido-reglas">

            <div class="contenedor-reglas">

                <div class="aviso-reglas">
                    <i class="fa-solid fa-circle-info"></i>
                    <p>
                        Estas son reglas generales propuestas para el sistema.
                        Consulta los reglamentos oficiales de la Universidad
                        de Lima para conocer las disposiciones vigentes.
                    </p>
                </div>

                <div class="rejilla-reglas">

                    <!-- Regla 1 -->
                    <article class="tarjeta-regla">
                        <div class="icono-regla">
                            <i class="fa-solid fa-calendar-check"></i>
                        </div>

                        <h2>1. Reservas de espacios</h2>

                        <ul>
                            <li>
                                Las reservas deben realizarse mediante
                                los canales autorizados.
                            </li>
                            <li>
                                Antes de reservar, verifica la disponibilidad
                                del espacio y el horario solicitado.
                            </li>
                            <li>
                                Utiliza el espacio únicamente durante
                                el periodo asignado.
                            </li>
                        </ul>
                    </article>

                    <!-- Regla 2 -->
                    <article class="tarjeta-regla">
                        <div class="icono-regla">
                            <i class="fa-solid fa-clock"></i>
                        </div>

                        <h2>2. Puntualidad y asistencia</h2>

                        <ul>
                            <li>
                                Acude puntualmente al horario reservado.
                            </li>
                            <li>
                                Si no puedes asistir, cancela la reserva
                                cuando el sistema lo permita.
                            </li>
                            <li>
                                Respeta los horarios de los usuarios
                                que tengan reservas posteriores.
                            </li>
                        </ul>
                    </article>

                    <!-- Regla 3 -->
                    <article class="tarjeta-regla">
                        <div class="icono-regla">
                            <i class="fa-solid fa-users"></i>
                        </div>

                        <h2>3. Uso de las instalaciones</h2>

                        <ul>
                            <li>
                                Respeta la capacidad máxima del espacio.
                            </li>
                            <li>
                                Mantén el orden y la limpieza durante
                                toda la actividad.
                            </li>
                            <li>
                                Utiliza las instalaciones de acuerdo
                                con su finalidad y las actividades permitidas.
                            </li>
                        </ul>
                    </article>

                    <!-- Regla 4 -->
                    <article class="tarjeta-regla">
                        <div class="icono-regla">
                            <i class="fa-solid fa-laptop"></i>
                        </div>

                        <h2>4. Equipos y mobiliario</h2>

                        <ul>
                            <li>
                                Manipula los equipos con cuidado.
                            </li>
                            <li>
                                No retires mobiliario ni equipos
                                sin autorización.
                            </li>
                            <li>
                                Comunica cualquier desperfecto o incidencia
                                al personal responsable.
                            </li>
                        </ul>
                    </article>

                    <!-- Regla 5 -->
                    <article class="tarjeta-regla">
                        <div class="icono-regla">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>

                        <h2>5. Convivencia y seguridad</h2>

                        <ul>
                            <li>
                                Respeta a los demás usuarios y al personal
                                universitario.
                            </li>
                            <li>
                                Evita conductas que interrumpan
                                las actividades de otros espacios.
                            </li>
                            <li>
                                Sigue las indicaciones de seguridad
                                de la universidad.
                            </li>
                        </ul>
                    </article>

                    <!-- Regla 6 -->
                    <article class="tarjeta-regla">
                        <div class="icono-regla">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </div>

                        <h2>6. Incidencias y restricciones</h2>

                        <ul>
                            <li>
                                Informa sobre problemas con los espacios
                                o sus equipos al personal responsable.
                            </li>
                            <li>
                                No utilices espacios que estén bloqueados
                                o fuera de servicio.
                            </li>
                            <li>
                                Cumple las disposiciones institucionales
                                aplicables al uso de las instalaciones.
                            </li>
                        </ul>
                    </article>

                </div>

                <!-- Pie informativo -->
                <div class="nota-reglas">
                    <i class="fa-solid fa-circle-check"></i>

                    <div>
                        <h3>Usa los espacios responsablemente</h3>
                        <p>
                            El cuidado de las instalaciones contribuye
                            a que todos puedan aprovechar los recursos
                            de la universidad.
                        </p>
                    </div>
                </div>

            </div>
        </section>

    </main>

