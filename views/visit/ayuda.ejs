<% layout("layouts/h1-visit") %>


    <main class="pagina-ayuda">

        <!-- Encabezado -->
        <section class="encabezado-ayuda">
            <div class="contenedor-ayuda">

                <span class="etiqueta-ayuda">
                    <i class="fa-solid fa-headset"></i>
                    Centro de soporte
                </span>

                <h1>¿Cómo podemos ayudarte?</h1>

                <p>
                    Encuentra respuestas a las preguntas frecuentes sobre
                    los espacios universitarios y el sistema de reservas.
                </p>

            </div>
        </section>

        <!-- Contenido -->
        <section class="contenido-ayuda">
            <div class="contenedor-ayuda">

                <!-- Contacto -->
                <div class="tarjeta-contacto">

                    <div class="icono-contacto">
                        <i class="fa-solid fa-envelope"></i>
                    </div>

                    <div class="texto-contacto">
                        <h2>¿Necesitas asistencia?</h2>

                        <p>
                            Si no encuentras la respuesta a tu consulta,
                            comunícate con el área responsable del sistema
                            de reservas.
                        </p>

                        <p class="contacto-pendiente">
                            Correo de soporte: soporte.reservas@ulima.edu.pe
                        </p>
                    </div>

                </div>

                <!-- Preguntas frecuentes -->
                <div class="titulo-faq">
                    <h2>Preguntas frecuentes</h2>
                    <p>
                        Respuestas a consultas habituales de los visitantes.
                    </p>
                </div>

                <div class="lista-faq">

                    <!-- Pregunta 1 -->
                    <details class="pregunta-faq">
                        <summary>
                            <span>¿Qué es Reserva ULima?</span>
                            <i class="fa-solid fa-chevron-down"></i>
                        </summary>

                        <div class="respuesta-faq">
                            Reserva ULima es un sistema orientado a consultar
                            espacios universitarios y facilitar la gestión
                            de sus reservas por parte de los usuarios
                            autorizados.
                        </div>
                    </details>

                    <!-- Pregunta 2 -->
                    <details class="pregunta-faq">
                        <summary>
                            <span>¿Cómo puedo consultar los espacios disponibles?</span>
                            <i class="fa-solid fa-chevron-down"></i>
                        </summary>

                        <div class="respuesta-faq">
                            Puedes revisar la sección de espacios para conocer
                            los ambientes registrados, sus características
                            y el equipamiento que tienen disponible.
                            La consulta pública no garantiza disponibilidad
                            en una fecha u hora determinada.
                        </div>
                    </details>

                    <!-- Pregunta 3 -->
                    <details class="pregunta-faq">
                        <summary>
                            <span>¿Puedo reservar un espacio como visitante?</span>
                            <i class="fa-solid fa-chevron-down"></i>
                        </summary>

                        <div class="respuesta-faq">
                            La vista de visitante permite consultar
                            información pública. Para realizar una reserva,
                            debes contar con una cuenta y los permisos
                            correspondientes, según las reglas del sistema.
                        </div>
                    </details>

                    <!-- Pregunta 4 -->
                    <details class="pregunta-faq">
                        <summary>
                            <span>¿Qué hago si un espacio presenta una falla?</span>
                            <i class="fa-solid fa-chevron-down"></i>
                        </summary>

                        <div class="respuesta-faq">
                            Comunica el problema al personal responsable
                            del espacio o al área encargada de atender
                            incidencias. Incluye el nombre o código del
                            espacio y una descripción del inconveniente.
                        </div>
                    </details>

                    <!-- Pregunta 5 -->
                    <details class="pregunta-faq">
                        <summary>
                            <span>¿Por qué no puedo acceder a una función?</span>
                            <i class="fa-solid fa-chevron-down"></i>
                        </summary>

                        <div class="respuesta-faq">
                            Algunas funciones están restringidas según
                            el rol y los permisos de la cuenta. Si consideras
                            que deberías tener acceso, consulta con el área
                            responsable del sistema.
                        </div>
                    </details>

                    <!-- Pregunta 6 -->
                    <details class="pregunta-faq">
                        <summary>
                            <span>¿Dónde puedo consultar las normas de uso?</span>
                            <i class="fa-solid fa-chevron-down"></i>
                        </summary>

                        <div class="respuesta-faq">
                            Puedes revisar las reglas generales de uso
                            en la sección correspondiente de Reserva ULima.
                            Para disposiciones oficiales, consulta los
                            reglamentos publicados por la universidad.
                        </div>
                    </details>

                </div>

                <!-- Acceso a reglas -->
                <div class="ayuda-reglas">
                    <div class="ayuda-reglas-icono">
                        <i class="fa-solid fa-book-open"></i>
                    </div>

                    <div class="ayuda-reglas-texto">
                        <h3>¿Quieres conocer las normas?</h3>
                        <p>
                            Revisa las recomendaciones para el uso responsable
                            de los espacios universitarios.
                        </p>
                    </div>

                    <a href="/reglas" class="btn-reglas">
                        Ver reglas
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>

            </div>
        </section>

    </main>
